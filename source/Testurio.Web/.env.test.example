# ─────────────────────────────────────────────────────────────────────────────
# Real E2E test suite environment variables
# Copy this file to .env.test and fill in the values.
# .env.test is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the portal being tested (e.g. http://localhost:3000 for local dev,
# or the staging URL for remote runs)
BASE_URL=http://localhost:3000

# Permanent test account credentials (Azure AD B2C / Entra External ID)
TEST_USER_EMAIL=e2e-test-user@example.com
TEST_USER_PASSWORD=YourTestPassword1!

# Cloudflare Access service token (only required when running against a CF-protected
# staging environment — leave empty for localhost)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: override the Playwright Chromium binary path
# (defaults to the standard ms-playwright install location)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
