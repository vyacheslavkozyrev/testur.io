NEXT_PUBLIC_API_BASE_URL=http://localhost:5225

# Azure AD B2C — Registration & Sign-In (feature 0013)
# NEXT_PUBLIC_B2C_TENANT:         Your B2C tenant name, e.g. "testuriob2c" (without .onmicrosoft.com)
# NEXT_PUBLIC_B2C_CLIENT_ID:      Application (client) ID from the Azure portal app registration
# NEXT_PUBLIC_B2C_AUTHORITY:      Full authority URL for the sign-up/sign-in user flow,
#                                 e.g. https://testuriob2c.b2clogin.com/testuriob2c.onmicrosoft.com/B2C_1_susi
# NEXT_PUBLIC_B2C_KNOWN_AUTHORITY: The B2C instance root used as a known authority for MSAL,
#                                 e.g. https://testuriob2c.b2clogin.com
# NEXT_PUBLIC_B2C_REDIRECT_URI:   Post-login redirect URI registered in the app registration,
#                                 e.g. http://localhost:3000/auth/callback
# NEXT_PUBLIC_B2C_SCOPES:         Space-separated list of API scopes to request,
#                                 e.g. "openid profile email"
NEXT_PUBLIC_B2C_TENANT=testuriob2cdevelop
NEXT_PUBLIC_B2C_CLIENT_ID=9a6f1553-d0bd-470c-af22-5cbf8a7745b4
NEXT_PUBLIC_B2C_AUTHORITY=https://testuriob2cdevelop.ciamlogin.com/987723e6-b3c0-48b1-a2d0-2ca3520581d5/v2.0
NEXT_PUBLIC_B2C_KNOWN_AUTHORITY=https://testuriob2cdevelop.ciamlogin.com
NEXT_PUBLIC_B2C_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_B2C_SCOPES=openid profile email offline_access
# Native Authentication API endpoint (required for CustomAuthPublicClientApplication).
# Format: https://<tenant>.ciamlogin.com/<tenant>.onmicrosoft.com/v1.0
# Note: Native Auth requires the CIAM tenant type — not a standard B2C tenant.
NEXT_PUBLIC_B2C_NATIVE_AUTH_URL=http://localhost:3000/ciam-proxy
