# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ARG NEXT_PUBLIC_B2C_TENANT
ARG NEXT_PUBLIC_B2C_CLIENT_ID
ARG NEXT_PUBLIC_B2C_AUTHORITY
ARG NEXT_PUBLIC_B2C_KNOWN_AUTHORITY
ARG NEXT_PUBLIC_B2C_REDIRECT_URI
ARG NEXT_PUBLIC_B2C_SCOPES
ARG NEXT_PUBLIC_B2C_NATIVE_AUTH_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_B2C_TENANT=$NEXT_PUBLIC_B2C_TENANT
ENV NEXT_PUBLIC_B2C_CLIENT_ID=$NEXT_PUBLIC_B2C_CLIENT_ID
ENV NEXT_PUBLIC_B2C_AUTHORITY=$NEXT_PUBLIC_B2C_AUTHORITY
ENV NEXT_PUBLIC_B2C_KNOWN_AUTHORITY=$NEXT_PUBLIC_B2C_KNOWN_AUTHORITY
ENV NEXT_PUBLIC_B2C_REDIRECT_URI=$NEXT_PUBLIC_B2C_REDIRECT_URI
ENV NEXT_PUBLIC_B2C_SCOPES=$NEXT_PUBLIC_B2C_SCOPES
ENV NEXT_PUBLIC_B2C_NATIVE_AUTH_URL=$NEXT_PUBLIC_B2C_NATIVE_AUTH_URL

COPY source/Testurio.Web/package.json source/Testurio.Web/package-lock.json ./
RUN npm ci --ignore-scripts

COPY source/Testurio.Web/ .

ENV NODE_ENV=production
RUN npm run build

# Stage 2: Runtime
FROM gcr.io/distroless/nodejs20-debian12 AS final
WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

CMD ["server.js"]
