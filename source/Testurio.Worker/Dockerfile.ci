# syntax=docker/dockerfile:1
# ---------------------------------------------------------------
# Dockerfile.ci — runtime only, for CI/CD pipeline use
# Binary is built outside Docker by the workflow (dotnet publish)
# and copied in here. No build stage, no SDK in the image.
#
# Uses aspnet:10.0 (Ubuntu 24.04 Noble) — NOT alpine — required
# for Playwright Chromium OS dependencies.
#
# Companion: Dockerfile (full multi-stage) for local development
# ---------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

# Install Playwright Chromium OS-level dependencies
# Note: Ubuntu 24.04 renames libasound2 → libasound2t64
RUN apt-get update && apt-get install -y \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libgtk-3-0 \
    libxshmfence1 \
    libasound2t64 \
    --no-install-recommends && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY source/Testurio.Worker/publish/ ./

ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright
ENV DOTNET_ENVIRONMENT=Production

USER $APP_UID

ENTRYPOINT ["dotnet", "Testurio.Worker.dll"]