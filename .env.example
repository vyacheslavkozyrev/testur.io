# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# ── Dual-source pattern ────────────────────────────────────────────────────────
# Local development: all values are read from this file (or .NET user secrets).
# Production (Azure App Service / Container Apps): non-secret values are set as
# app settings; the 7 variables marked [KEY VAULT] are loaded from Azure Key
# Vault at startup via Managed Identity — they should NOT be set as app settings
# in production. The Key Vault secret name is shown in each annotation.
# ──────────────────────────────────────────────────────────────────────────────

# ── Shared: Azure Infrastructure ──────────────────────────────────────────────
# [KEY VAULT in production — secret name: cosmos-connection-string]
Infrastructure__CosmosConnectionString=AccountEndpoint=https://<account>.documents.azure.com:443/;AccountKey=<key>==
Infrastructure__CosmosDatabaseName=testurio
# [KEY VAULT in production — secret name: servicebus-connection-string]
Infrastructure__ServiceBusConnectionString=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>==
Infrastructure__TestRunJobQueueName=story-test-pipeline
# [KEY VAULT in production — secret name: blob-storage-connection-string]
Infrastructure__BlobStorageConnectionString=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>==;EndpointSuffix=core.windows.net
Infrastructure__ExecutionLogsBlobContainerName=execution-logs
Infrastructure__ReportTemplatesBlobContainerName=report-templates
Infrastructure__ReportsBlobContainerName=test-reports

# ── Api: Auth ─────────────────────────────────────────────────────────────────
AzureAdB2C__Authority=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
AzureAdB2C__ClientId=<client-id>

# ── Api: Stripe ───────────────────────────────────────────────────────────────
# [KEY VAULT in production — secret name: stripe-secret-key]
Stripe__SecretKey=sk_test_...
# [KEY VAULT in production — secret name: stripe-webhook-secret]
Stripe__WebhookSecret=whsec_...
Stripe__PriceIds__TestJunior_Monthly=price_...
Stripe__PriceIds__TestJunior_Annual=price_...
Stripe__PriceIds__TestPro_Monthly=price_...
Stripe__PriceIds__TestPro_Annual=price_...
Stripe__PriceIds__Team_Monthly=price_...
Stripe__PriceIds__Team_Annual=price_...
Stripe__PriceIds__Centurio_Monthly=price_...
Stripe__PriceIds__Centurio_Annual=price_...

# ── Api: App ──────────────────────────────────────────────────────────────────
App__BaseUrl=http://localhost:3000

# ── Worker: Claude ────────────────────────────────────────────────────────────
# [KEY VAULT in production — secret name: anthropic-api-key]
Claude__ApiKey=sk-ant-...
Claude__ModelId=claude-haiku-4-5-20251001

# ── Worker: Azure OpenAI (embeddings) ─────────────────────────────────────────
AzureOpenAI__Endpoint=https://<account>.openai.azure.com/
# [KEY VAULT in production — secret name: azure-openai-api-key]
AzureOpenAI__ApiKey=<azure-openai-api-key>
AzureOpenAI__EmbeddingDeployment=text-embedding-3-small

# ── Web: Next.js ──────────────────────────────────────────────────────────────
# URL the browser uses to reach the API — must be accessible from the host machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
